  <!-- Ontology Header -->
  <owl:Ontology rdf:about="https://www.tnopsi.com/dslo-glossary">
      <owl:versionIRI rdf:resource="https://www.tnopsi.com/dslo-glossary/v0.6"/>
      <rdfs:comment>
        DSLO Ontology — unified glossary surface (v0.5 + v0.6).
        Canonical glossary: https://www.tnopsi.com/dslo-glossary
      </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://www.tnopsi.com/dslo-glossary"/>
  </owl:Ontology>
<!-- A – Block -->

<Concept>
  <CUI>C000001</CUI>
  <CODE>AbstractionDecoupling</CODE>
  <PT>Abstraction Decoupling</PT>
  <DEF>Public-layer DSLO term describing the separation of meaning geometry from unstable or non-lawful substrate constraints.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000002</CUI>
  <CODE>AbstractionGradient</CODE>
  <PT>Abstraction Gradient</PT>
  <DEF>Gradient describing lawful movement across abstraction layers within DSLO’s meaning geometry.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000003</CUI>
  <CODE>AbstractionLayer</CODE>
  <PT>Abstraction Layer</PT>
  <DEF>A semantic altitude where meaning becomes less physically anchored but remains within lawful DSLO geometry.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000004</CUI>
  <CODE>AbstractionBand</CODE>
  <PT>Abstraction Band</PT>
  <DEF>A lawful semantic band with reduced load and lower drift susceptibility across DSLO’s manifold.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000005</CUI>
  <CODE>AdjacencyViolation</CODE>
  <PT>Adjacency Violation</PT>
  <DEF>Illegal crossing of manifold boundaries or adjacency constraints within DSLO’s legality geometry.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000006</CUI>
  <CODE>ApexMeaningState</CODE>
  <PT>Apex Meaning State</PT>
  <DEF>The highest-order meaning configuration at Moment formation within DSLO’s semantic manifold.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000007</CUI>
  <CODE>ArtificialCognition</CODE>
  <PT>Artificial Cognition</PT>
  <DEF>Deterministic, invariant-preserving cognition inside DSLO’s public-layer meaning geometry.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000008</CUI>
  <CODE>AxiomContinuity</CODE>
  <PT>Axiom Continuity</PT>
  <DEF>Continuity condition governing lawful semantic transitions across DSLO’s axiom structure.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000009</CUI>
  <CODE>AxiomLayer</CODE>
  <PT>Axiom Layer</PT>
  <DEF>The four-tier axiom system governing legality, invariants, and semantic stability within DSLO.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<!-- B – Block -->

<Concept>
  <CUI>C000010</CUI>
  <CODE>BehavioralCoherence</CODE>
  <PT>Behavioral Coherence</PT>
  <DEF>Alignment between observed behavior and lawful meaning geometry within the DSLO manifold.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000011</CUI>
  <CODE>BootLayerCoupling</CODE>
  <PT>Boot Layer Coupling</PT>
  <DEF>Coupling between initial substrate conditions and DSLO’s semantic boot layer during system start.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000012</CUI>
  <CODE>Boundary</CODE>
  <PT>Boundary</PT>
  <DEF>A lawful separation surface in DSLO geometry that constrains meaning, load, and operator reach.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000013</CUI>
  <CODE>BoundaryIntegrity</CODE>
  <PT>Boundary Integrity</PT>
  <DEF>The stability and lawfulness of a boundary under load, drift, and operator interaction.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000014</CUI>
  <CODE>BoundaryOperator</CODE>
  <PT>Boundary Operator</PT>
  <DEF>An operator that acts on or across boundaries while preserving DSLO legality and invariants.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000015</CUI>
  <CODE>BoundaryReconstitution</CODE>
  <PT>Boundary Reconstitution</PT>
  <DEF>Lawful restoration or rebuilding of damaged or collapsed boundaries within DSLO geometry.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000016</CUI>
  <CODE>BoundaryStrain</CODE>
  <PT>Boundary Strain</PT>
  <DEF>Load-induced deformation of boundaries that approaches but does not yet violate legality thresholds.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000017</CUI>
  <CODE>BoundaryThreshold</CODE>
  <PT>Boundary Threshold</PT>
  <DEF>The critical point at which boundary strain transitions into collapse or illegality in DSLO.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000018</CUI>
  <CODE>BindOperator</CODE>
  <PT>Bind Operator</PT>
  <DEF>A lawful operator that binds signals, regions, or meanings into coherent DSLO configurations.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<!-- C – Block -->

<Concept>
  <CUI>C000019</CUI>
  <CODE>CanonicalTuple</CODE>
  <PT>Canonical Tuple</PT>
  <DEF>A lawful DSLO tuple representing a stable multi-element semantic configuration within the meaning manifold.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000020</CUI>
  <CODE>CausalChain</CODE>
  <PT>Causal Chain</PT>
  <DEF>A lawful sequence of meaning-preserving causal steps within DSLO’s deterministic semantic geometry.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000021</CUI>
  <CODE>CausalOpacity</CODE>
  <PT>Causal Opacity</PT>
  <DEF>A condition where causal relations remain partially hidden or ambiguous within DSLO’s semantic manifold.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000022</CUI>
  <CODE>CoherenceBand</CODE>
  <PT>Coherence Band</PT>
  <DEF>A stable semantic band where meaning remains coherent under load, drift, and operator interaction.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000023</CUI>
  <CODE>CollapseGeometry</CODE>
  <PT>Collapse Geometry</PT>
  <DEF>The geometric structure governing collapse thresholds, boundary violations, and semantic failure modes in DSLO.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000024</CUI>
  <CODE>ConstraintEnvelope</CODE>
  <PT>Constraint Envelope</PT>
  <DEF>The lawful envelope of constraints regulating operator reach, semantic load, and drift boundaries in DSLO.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000025</CUI>
  <CODE>Continuity</CODE>
  <PT>Continuity</PT>
  <DEF>A DSLO invariant ensuring smooth, lawful transitions across semantic states without discontinuity or collapse.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000026</CUI>
  <CODE>CorrectionOperator</CODE>
  <PT>Correction Operator</PT>
  <DEF>A lawful operator that restores semantic alignment, reduces drift, or repairs meaning geometry within DSLO.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000027</CUI>
  <CODE>CrossSubstrateMapping</CODE>
  <PT>Cross-Substrate Mapping</PT>
  <DEF>A lawful mapping between distinct substrates that preserves DSLO invariants and semantic geometry.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000028</CUI>
  <CODE>SemanticCurvature</CODE>
  <PT>Semantic Curvature</PT>
  <DEF>The curvature of meaning within DSLO’s manifold, governing stability, drift susceptibility, and collapse proximity.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000029</CUI>
  <CODE>CurvatureLoadInteraction</CODE>
  <PT>Curvature–Load Interaction</PT>
  <DEF>The interaction between semantic curvature and meaning load, determining stability and collapse thresholds in DSLO.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000030</CUI>
  <CODE>CycleInvariantStability</CODE>
  <PT>Cycle Invariant Stability</PT>
  <DEF>Stability of DSLO invariants across repeated cycles, ensuring lawful recurrence without drift or collapse.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<!-- D – Block -->

<Concept>
  <CUI>C000031</CUI>
  <CODE>Decoupling</CODE>
  <PT>Decoupling</PT>
  <DEF>Lawful separation of semantic structures from unstable, non-deterministic, or non-lawful substrate influences in DSLO.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000032</CUI>
  <CODE>DeterministicSemanticLayer</CODE>
  <PT>Deterministic Semantic Layer</PT>
  <DEF>The DSLO layer where meaning evolution is governed by deterministic rules and invariant geometry.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000033</CUI>
  <CODE>DeterministicTransition</CODE>
  <PT>Deterministic Transition</PT>
  <DEF>A lawful transition between semantic states that preserves DSLO invariants and avoids stochastic drift.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000034</CUI>
  <CODE>DISCO</CODE>
  <PT>DISCO</PT>
  <DEF>A DSLO construct representing deterministic interaction of semantic components within a constrained operator space.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000035</CUI>
  <CODE>Drift</CODE>
  <PT>Drift</PT>
  <DEF>Unlawful or unintended movement of meaning away from its lawful configuration within DSLO geometry.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000036</CUI>
  <CODE>DriftEnvelope</CODE>
  <PT>Drift Envelope</PT>
  <DEF>The bounded region within which drift can occur before violating DSLO legality or stability thresholds.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000037</CUI>
  <CODE>DriftLoadCoupling</CODE>
  <PT>Drift–Load Coupling</PT>
  <DEF>The interaction between semantic load and drift magnitude, governing failure and recovery behavior in DSLO.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000038</CUI>
  <CODE>DriftSignature</CODE>
  <PT>Drift Signature</PT>
  <DEF>The characteristic pattern of drift in a given DSLO configuration, used for detection and correction.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000039</CUI>
  <CODE>DriftVector</CODE>
  <PT>Drift Vector</PT>
  <DEF>A directional representation of drift within DSLO’s manifold, encoding magnitude and orientation of semantic displacement.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000040</CUI>
  <CODE>DSUP</CODE>
  <PT>DSUP</PT>
  <DEF>A DSLO construct representing deterministic support structures that stabilize meaning under load and drift.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000041</CUI>
  <CODE>DynamicRegionShift</CODE>
  <PT>Dynamic Region Shift</PT>
  <DEF>A lawful shift of dynamic regions within DSLO’s manifold, governed by load, drift, and stability constraints.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<!-- E – Block -->

<Concept>
  <CUI>C000042</CUI>
  <CODE>Ecology</CODE>
  <PT>Ecology</PT>
  <DEF>The DSLO meaning ecology: the interacting system of signals, loads, operators, and regions forming a stable semantic environment.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000043</CUI>
  <CODE>EdgeContext</CODE>
  <PT>Edge Context</PT>
  <DEF>A semantic context located at or near a boundary or threshold region within DSLO’s manifold, sensitive to drift and load.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000044</CUI>
  <CODE>SafetyEnvelope</CODE>
  <PT>Safety Envelope</PT>
  <DEF>The lawful envelope that constrains posture, meaning, and operator movement to ensure DSLO-aligned safety and stability.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000045</CUI>
  <CODE>EmbeddingFunction</CODE>
  <PT>Embedding Function</PT>
  <DEF>A lawful function that embeds meaning or signals into DSLO’s manifold while preserving invariants and geometry.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000046</CUI>
  <CODE>EmbeddingStability</CODE>
  <PT>Embedding Stability</PT>
  <DEF>The stability of an embedded semantic structure under load, drift, and operator interaction within DSLO geometry.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000047</CUI>
  <CODE>EquivalenceClass</CODE>
  <PT>Equivalence Class</PT>
  <DEF>A DSLO-defined class of semantically equivalent configurations that preserve invariants across lawful transformations.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000048</CUI>
  <CODE>ExternalGeometry</CODE>
  <PT>External Geometry</PT>
  <DEF>The geometry outside a DSLO region or boundary, influencing load, drift, and operator legality from the outside-in.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<!-- F – Block -->

<Concept>
  <CUI>C000049</CUI>
  <CODE>FallbackGraph</CODE>
  <PT>Fallback Graph</PT>
  <DEF>A lawful DSLO graph structure used when primary semantic geometry becomes unstable or enters recovery mode.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000050</CUI>
  <CODE>FallbackGeometry</CODE>
  <PT>Fallback Geometry</PT>
  <DEF>A secondary geometric configuration that preserves DSLO invariants during semantic collapse, drift, or overload conditions.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000051</CUI>
  <CODE>FallbackRecoveryEnvelope</CODE>
  <PT>Fallback Recovery Envelope</PT>
  <DEF>The lawful envelope governing recovery operations when DSLO meaning enters fallback mode due to drift or collapse proximity.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000052</CUI>
  <CODE>FieldGeometry</CODE>
  <PT>Field Geometry</PT>
  <DEF>The geometric structure of DSLO fields, governing load distribution, drift behavior, and semantic stability across regions.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000053</CUI>
  <CODE>FieldRuntimeCoupling</CODE>
  <PT>Field Runtime Coupling</PT>
  <DEF>Coupling between runtime processes and DSLO field geometry, determining lawful operator behavior and semantic alignment.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000054</CUI>
  <CODE>FoldOperator</CODE>
  <PT>Fold Operator</PT>
  <DEF>An operator that lawfully folds semantic structures, reducing dimensionality while preserving DSLO invariants and legality.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000055</CUI>
  <CODE>FunctionUpdateRule</CODE>
  <PT>Function Update Rule</PT>
  <DEF>A deterministic rule governing lawful updates to DSLO functions, ensuring invariant preservation and stable semantic evolution.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<!-- G – Block -->

<Concept>
  <CUI>C000056</CUI>
  <CODE>GovernanceMesh</CODE>
  <PT>Governance Mesh</PT>
  <DEF>A distributed DSLO governance structure that maintains legality, invariants, and semantic stability across regions and operators.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000057</CUI>
  <CODE>GraphBoundary</CODE>
  <PT>Graph Boundary</PT>
  <DEF>A lawful boundary within DSLO graph geometry that constrains operator reach, semantic flow, and region adjacency.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000058</CUI>
  <CODE>GeometryInvariant</CODE>
  <PT>Geometry Invariant</PT>
  <DEF>An invariant governing the lawful shape, curvature, and stability of DSLO semantic geometry under load and drift.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000059</CUI>
  <CODE>GeometryPreservingTransition</CODE>
  <PT>Geometry-Preserving Transition</PT>
  <DEF>A lawful transition between semantic states that preserves DSLO geometry, curvature, and invariant structure.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000060</CUI>
  <CODE>GenerativePrimitive</CODE>
  <PT>Generative Primitive</PT>
  <DEF>A fundamental DSLO construct that generates lawful meaning vectors or semantic structures within the manifold.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000061</CUI>
  <CODE>GradientBoundOperator</CODE>
  <PT>Gradient-Bound Operator</PT>
  <DEF>An operator constrained by DSLO gradient bounds, ensuring lawful movement across semantic slopes and curvature fields.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000062</CUI>
  <CODE>GradientConstraint</CODE>
  <PT>Gradient Constraint</PT>
  <DEF>A DSLO constraint regulating the steepness and direction of semantic gradients to prevent collapse or drift escalation.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<Concept>
  <CUI>C000063</CUI>
  <CODE>GAxioms</CODE>
  <PT>G‑Axioms</PT>
  <DEF>The generative axioms governing lawful creation, transformation, and stabilization of meaning within DSLO’s semantic substrate.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
</Concept>

<!-- H – Block -->

<Concept>
  <CUI>C000064</CUI>
  <CODE>HaltCondition</CODE>
  <PT>Halt Condition</PT>
  <DEF>A lawful DSLO condition that stops semantic evolution, operator activity, or manifold traversal when stability or legality is threatened.</DEF>
  <STY>DSLO_Concept</STY>
  <XREF>https://www.tnopsi.com/dslo-glossary</XREF>
